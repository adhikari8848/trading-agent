# ---- OpenAI (required) ----
OPENAI_API_KEY=

# ---- Alpaca paper trading (required for mode: paper) ----
# alpaca.markets > Paper account > API Keys > Generate
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# ---- Alpaca live trading (only for mode: live) ----
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# ---- Telegram (required for live mode) ----
# Token from @BotFather. Then run:  python -m agent telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional data sources ----
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=
#SEC_EDGAR_USER_AGENT=Your Name you@example.com
